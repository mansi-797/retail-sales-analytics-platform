    {
      "name": "4f90b4d6",
      "displayName": "Top Selling Products and Categories Overview",
      "queryLines": [
        "SELECT\r\n",
        "    product_name,\r\n",
        "    category,\r\n",
        "    total_sales\r\n",
        "FROM fmcg.gold.product_sales\r\n",
        "ORDER BY total_sales DESC\r\n",
        "LIMIT 10;"
      ]
    }
